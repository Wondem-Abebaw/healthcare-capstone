# ── LLM ───────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_gemini_api_key_here

# ── Observability ──────────────────────────────────────────────────────────
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=healthcare-ai-capstone

# ── App ────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:3000

# ── These are set via docker-compose env but can be overridden locally ─────
DATABASE_URL=postgresql+asyncpg://hc_user:hc_secret@localhost:5432/healthcare_ai
QDRANT_URL=http://localhost:6333
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=hc_minio_user
MINIO_SECRET_KEY=hc_minio_secret
MINIO_SECURE=false
